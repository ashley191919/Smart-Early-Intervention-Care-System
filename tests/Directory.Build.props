<Project>
  <!-- All lightweight harness projects live in this folder. Give each one its own
       NuGet/MSBuild intermediate directory so incremental builds cannot run another
       harness's generated entry point. This file does not apply to the API project. -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
